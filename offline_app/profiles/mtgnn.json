{
  "version": "evaluation.config.v1",
  "plugin": "mtgnn",
  "source_root": "",
  "checkpoint": {
    "path": ""
  },
  "dataset": {
    "name": "Exchange-Rate",
    "path": "",
    "format": "mtgnn_numeric_matrix",
    "date_column": "not_provided",
    "variables": [
      "EX0",
      "EX1",
      "EX2",
      "EX3",
      "EX4",
      "EX5",
      "EX6",
      "EX7"
    ],
    "features": "M",
    "target": "EX0",
    "frequency": "daily",
    "seq_len": 168,
    "label_len": 1,
    "pred_len": 1
  },
  "adapter_config": {
    "random_seed": 42,
    "model": {
      "gcn_true": true,
      "build_a_true": true,
      "gcn_depth": 2,
      "num_nodes": 8,
      "dropout": 0.3,
      "subgraph_size": 8,
      "node_dim": 40,
      "dilation_exponential": 2,
      "conv_channels": 16,
      "residual_channels": 16,
      "skip_channels": 32,
      "end_channels": 64,
      "in_dim": 1,
      "seq_in_len": 168,
      "seq_out_len": 1,
      "horizon": 3,
      "layers": 5,
      "propalpha": 0.05,
      "tanhalpha": 3,
      "layer_norm_affline": false,
      "normalize": 2,
      "train_ratio": 0.6,
      "validation_ratio": 0.2
    }
  },
  "split": "test",
  "samples": [
    0,
    1,
    2
  ],
  "threads": 2
}
