{
  "name": "dgrainsight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive offline edge-removal evaluation for graph forecasting models.",
  "scripts": {
    "test": "npm run test:performance && node tests/evaluationRegression.mjs && node tests/webGraphRegression.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test:web-graph-regression": "node tests/webGraphRegression.mjs",
    "test:web-graph": "node tests/webGraphRegression.mjs",
    "preview": "vite preview --config vite.config.ts",
    "deploy": "npm run build && gh-pages -d dist",
    "test:performance": "node tests/performanceRegression.mjs",
    "test:performance-browser": "node tests/performanceBrowserRegression.mjs",
    "test:web-performance": "node tests/performanceBrowserRegression.mjs",
    "test:evaluation": "python -X utf8 -m unittest discover -s tests -p test_evaluation.py && python -X utf8 -m unittest discover -s tests -p test_thin_adapter.py && node tests/evaluationRegression.mjs",
    "test:evaluation-browser": "node tests/evaluationBrowserRegression.mjs",
    "test:web-evaluation": "node tests/evaluationBrowserRegression.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.2",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.3.8",
    "katex": "^0.17.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
